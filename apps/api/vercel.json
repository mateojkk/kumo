{
  "version": 2,
  "functions": {
    "src/functions/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/remember",     "destination": "/src/functions/remember" },
    { "source": "/recall",       "destination": "/src/functions/recall" },
    { "source": "/analyze",      "destination": "/src/functions/analyze" },
    { "source": "/discover",     "destination": "/src/functions/discover" },
    { "source": "/registry",     "destination": "/src/functions/registry" },
    { "source": "/agent/:id",    "destination": "/src/functions/profile" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,PATCH,DELETE,POST,PUT" },
        { "key": "Access-Control-Allow-Headers", "value": "X-CSRF-Token, X-Requested-With, Accept, Accept-Version, Content-Length, Content-MD5, Content-Type, Date, X-Api-Version, x-agent-id, x-api-key, x-402-signature, payment-signature" }
      ]
    }
  ]
}
